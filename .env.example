# 环境变量配置示例 (Environment Variables Configuration Example)
# 复制此文件为 .env 并填入实际值

# ============================================
# 安全配置 (Security Configuration)
# ============================================

# 管理后台密钥（必须设置！使用强随机密钥）
# 生成方法: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_SECRET_KEY=your_secret_key_here_change_me

# SSL证书验证（生产环境建议设置为 true）
SSL_VERIFY=false

# CORS 允许的来源（生产环境必须配置具体域名，不要使用 *）
# 多个域名用逗号分隔
CORS_ORIGINS=*

# Flask 运行环境（production 或 development）
FLASK_ENV=development

# 通用环境标识（production 或 development）
ENVIRONMENT=development

# ============================================
# 速率限制配置 (Rate Limiting Configuration)
# ============================================

# 是否启用速率限制
RATE_LIMIT_ENABLED=true

# 每分钟允许的请求次数
RATE_LIMIT_REQUESTS=60

# ============================================
# 日志配置 (Logging Configuration)
# ============================================

# 日志级别: DEBUG, INFO, ERROR
LOG_LEVEL=INFO

# ============================================
# 生产环境安全配置示例
# ============================================

# 生产环境配置应该类似：
# ADMIN_SECRET_KEY=<使用 secrets.token_urlsafe(32) 生成的密钥>
# SSL_VERIFY=true
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
# FLASK_ENV=production
# ENVIRONMENT=production
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS=100
# LOG_LEVEL=INFO

# ============================================
# 注意事项 (Important Notes)
# ============================================

# 1. 不要将此文件中的敏感信息提交到版本控制系统
# 2. 生产环境必须修改所有默认值
# 3. 定期轮换密钥
# 4. 使用强随机密钥，不要使用简单密码
# 5. 启用HTTPS并设置 SSL_VERIFY=true
# 6. 限制 CORS_ORIGINS 到信任的域名
